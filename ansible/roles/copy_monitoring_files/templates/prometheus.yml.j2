global:
  scrape_interval: 15s
  evaluation_interval: 15s


scrape_configs:
  - job_name: 'monitoring_node'
    static_configs:
      - targets: ['node-exporter:9100']

  - job_name: 'web_nodes'
    static_configs:
      - targets:
        # Цикл пробегается по всем серверам в группе [web] и берет их внутренние IP
        {% for host in groups['web'] %}
        - '{{ hostvars[host]["internal_ip"] }}:9100'
        {% endfor %}